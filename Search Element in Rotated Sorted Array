//Search Element in Rotated Sorted Array1

int search(vector<int>& nums, int target) {
        int n = nums.size();

        int l =0, r = n-1;

        while(l<=r){
            int mid = l+(r-l)/2;

            if(target==nums[mid]){
                return mid;
            }
            //left sorted
            if(nums[l]<=nums[mid]){
                if(target>=nums[l] && target<= nums[mid]){
                    r= mid-1;
                }
                else{
                    l = mid+1;
                }
            }

            //right sorted
            else{
                if(target>=nums[mid] && target<=nums[r]){
                    l = mid+1;
                }
                else{
                    r = mid-1;
                }
            }
        }
        return -1;
    }


//Search Element in Rotated Sorted Array 2

bool search(vector<int>& nums, int target) {
        int n = nums.size();

        int l =0, r = n-1;

        while(l<=r){
            int mid = l+(r-l)/2;

            if(target==nums[mid]){
                return 1;
            }
            if(nums[mid]==nums[r] && nums[mid]==nums[l]){
                l++;
                r--;
                continue;
            }
            //left sorted
            else if(nums[l]<=nums[mid]){
                if(target>=nums[l] && target<= nums[mid]){
                    r= mid-1;
                }
                else{
                    l = mid+1;
                }
            }

            //right sorted
            else{
                if(target>=nums[mid] && target<=nums[r]){
                    l = mid+1;
                }
                else{
                    r = mid-1;
                }
            }
        }
        return 0;
    }
